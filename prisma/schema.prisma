generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  in_progress
  submitted
}

enum CollectionStatus {
  not_collected
  collected
  partially_collected
}

enum RaterRole {
  rater
  manager
  admin
}

enum DraftStatus {
  setup
  in_progress
  complete
}

enum DraftTradeRequestStatus {
  pending
  accepted
  rejected
  cancelled
}

model League {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  players     Player[]
  raters      Rater[]
  settings    AppSetting[]
  submissions RatingSubmission[]
  drafts      Draft[]
}

model Player {
  id                     String                 @id @default(cuid())
  leagueId               String
  firstName              String
  lastName               String
  link                   String?
  avatarImage            Bytes?
  avatarImageContentType String?
  avatarImageFetchedAt   DateTime?
  active                 Boolean                @default(true)
  league                 League                 @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  ratings                PlayerRating[]
  draftPlayers           DraftPlayer[]
  draftStartingPlayers   DraftStartingPlayer[]
  draftPicks             DraftPick[]
  draftScoreExclusions   DraftScoreExclusion[]
  draftScoreOverrides    DraftScoreOverride[]
  captainPlayerFlags     CaptainPlayerFlag[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([leagueId, lastName, firstName])
  @@index([lastName, firstName])
}

model Rater {
  id                   String                 @id @default(cuid())
  leagueId             String
  name                 String
  email                String
  passcodeDisplay      String?
  role                 RaterRole              @default(rater)
  active               Boolean                @default(true)
  league               League                 @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  inviteCodes          InviteCode[]
  submissions          RatingSubmission[]
  draftTeams           DraftTeam[]
  draftScoreExclusions DraftScoreExclusion[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([leagueId, email])
  @@index([leagueId])
}

model InviteCode {
  id         String    @id @default(cuid())
  raterId    String
  codeHash   String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  rater      Rater     @relation(fields: [raterId], references: [id], onDelete: Cascade)

  @@index([raterId, expiresAt])
}

model AppSetting {
  leagueId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@id([leagueId, key])
}

model RatingSubmission {
  id                         String           @id @default(cuid())
  leagueId                   String
  raterId                    String
  seasonLabel                String
  status                     SubmissionStatus @default(in_progress)
  collectionStatus           CollectionStatus @default(not_collected)
  collectionStatusAt         DateTime?
  collectedActivePlayerCount Int?
  adminLocked                Boolean          @default(false)
  submittedAt                DateTime?
  lastAutosavedAt            DateTime?
  lastSyncedAt               DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  league                     League           @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  rater                      Rater            @relation(fields: [raterId], references: [id], onDelete: Cascade)
  ratings                    PlayerRating[]

  @@unique([raterId, seasonLabel])
  @@index([status])
  @@index([leagueId])
}

model PlayerRating {
  id            String           @id @default(cuid())
  submissionId  String
  playerId      String
  power         Int?
  accuracy      Int?
  intimidation  Int?
  catching      Int?
  evasion       Int?
  nerve         Int?
  unknownPlayer Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  submission    RatingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  player        Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([submissionId, playerId])
}

model Draft {
  id               String                @id @default(cuid())
  leagueId         String
  name             String
  seasonLabel      String
  status           DraftStatus           @default(setup)
  isLive           Boolean               @default(false)
  teamCount        Int
  rankThresholds   String
  minQuotasEnabled Boolean               @default(true)
  maxQuotasEnabled Boolean               @default(true)
  /** snake | lowest_avg — how the on-clock team is chosen */
  pickOrderMode    String                @default("snake")
  displaySettings  String                @default("{}")
  liveAt           DateTime?
  onClockStartedAt DateTime?
  nextPickNumber   Int                   @default(1)
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  league           League                @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  players          DraftPlayer[]
  teams            DraftTeam[]
  picks            DraftPick[]
  startingPlayers  DraftStartingPlayer[]
  scoreExclusions  DraftScoreExclusion[]
  scoreOverrides   DraftScoreOverride[]
  captainFlags     CaptainPlayerFlag[]
  tradeRequests    DraftTradeRequest[]

  @@index([status])
  @@index([seasonLabel])
  @@index([leagueId])
}

model DraftPlayer {
  id        String   @id @default(cuid())
  draftId   String
  playerId  String
  createdAt DateTime @default(now())
  draft     Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([draftId, playerId])
  @@index([draftId])
}

model DraftTeam {
  id              String                 @id @default(cuid())
  draftId         String
  raterId         String
  pickOrder       Int
  color           String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  draft           Draft                  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  rater           Rater                  @relation(fields: [raterId], references: [id], onDelete: Restrict)
  startingPlayers DraftStartingPlayer[]
  picks           DraftPick[]
  captainFlags    CaptainPlayerFlag[]
  proposedTrades  DraftTradeRequest[]    @relation("ProposedTrades")
  receivedTrades  DraftTradeRequest[]    @relation("ReceivedTrades")

  @@unique([draftId, raterId])
  @@unique([draftId, pickOrder])
  @@index([draftId])
}

model DraftStartingPlayer {
  id        String    @id @default(cuid())
  draftId   String
  teamId    String
  playerId  String
  createdAt DateTime  @default(now())
  draft     Draft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  team      DraftTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([draftId, playerId])
  @@index([teamId])
}

model DraftPick {
  id         String    @id @default(cuid())
  draftId    String
  teamId     String
  playerId   String
  pickNumber Int
  round      Int
  pickedAt   DateTime  @default(now())
  draft      Draft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  team       DraftTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([draftId, playerId])
  @@unique([draftId, pickNumber])
  @@index([draftId, teamId])
}

model DraftScoreExclusion {
  id        String   @id @default(cuid())
  draftId   String
  playerId  String
  raterId   String
  createdAt DateTime @default(now())
  draft     Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rater     Rater    @relation(fields: [raterId], references: [id], onDelete: Cascade)

  @@unique([draftId, playerId, raterId])
  @@index([draftId, playerId])
}

model DraftScoreOverride {
  id        String   @id @default(cuid())
  draftId   String
  playerId  String
  metric    String
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  draft     Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([draftId, playerId, metric])
  @@index([draftId, playerId])
}

model CaptainPlayerFlag {
  id        String    @id @default(cuid())
  draftId   String
  teamId    String
  playerId  String
  createdAt DateTime  @default(now())
  draft     Draft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  team      DraftTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([draftId, teamId, playerId])
  @@index([teamId])
}

model DraftTradeRequest {
  id                 String                  @id @default(cuid())
  draftId            String
  proposingTeamId    String
  counterpartyTeamId String
  offeredPlayerId    String
  requestedPlayerId  String
  status             DraftTradeRequestStatus @default(pending)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  resolvedAt         DateTime?
  draft              Draft                   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  proposingTeam      DraftTeam               @relation("ProposedTrades", fields: [proposingTeamId], references: [id], onDelete: Cascade)
  counterpartyTeam   DraftTeam               @relation("ReceivedTrades", fields: [counterpartyTeamId], references: [id], onDelete: Cascade)

  @@index([draftId, status])
  @@index([proposingTeamId, status])
  @@index([counterpartyTeamId, status])
}
